# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=""

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=""

# JWT Secret Key, in this case from Supabase. Needed to decrypt sessions.
AUTH_JWT_KEY=""

# Supabase Project ID
SUPABASE_PROJECT_URL=""
# Supabase service role key, for the Admin API in `pnpm seed:admins` only (creates auth users). Never in app code.
SUPABASE_SERVICE_ROLE_KEY=""

# Public Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# --- Sign-in (ADR-0008). Google itself is configured in the Supabase dashboard, not here.
# Comma-separated @authoritysolutions.com emails that `pnpm seed:admins` makes admins.
SEED_ADMIN_EMAILS=""

# --- Background jobs (Inngest). Leave both empty locally: `pnpm dev:inngest` runs the local dev server,
# and INNGEST_DEV=1 comes from the committed .env.development. Never put INNGEST_DEV here or on a deployment.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# --- Every model call goes through OpenRouter. The default model; a job may name another.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-sonnet-5.5"

# --- GoHighLevel (spec 06). Read-only token until a dev sub-account exists.
GHL_PRIVATE_TOKEN=""
GHL_LOCATION_ID="9Q6zIpMRGSX5wfUk6fjC"
# Pipeline, stage, custom-field, calendar and placeholder-user ids as JSON (spec 06, "Configuration per environment").
GHL_IDS=""
# Shared secret Lee's outbound webhooks send; any long random string agreed with Lee.
GHL_WEBHOOK_SECRET=""
# Leave "false" until the supervised write session with Lee (spec 06, "Working without a dev location").
GHL_WRITES_ENABLED="false"

# --- Presenton on Render (spec 09; deploy/presenton/README.md).
PRESENTON_URL=""
PRESENTON_API_KEY=""

# --- Fathom (spec 11). The integration user's API key, and the secret Fathom returns when the webhook is registered.
FATHOM_API_KEY=""
FATHOM_WEBHOOK_SECRET=""

# Committed, and loaded by Next only when NODE_ENV=development (`pnpm dev`), never by
# `next build` or vitest. It exists so INNGEST_DEV stays out of .env.example, the file
# people copy. Nothing secret belongs here: it is in git, so treat it as public.
#
# Never copy this into Vercel or any deployed environment: in dev mode the Inngest SDK
# skips request signing, which would leave /api/inngest unauthenticated. The route's
# guard (src/lib/inngest/assert-cloud-mode.ts) fails the build if it happens.
INNGEST_DEV=1
